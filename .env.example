# ─────────────────────────────────────────────────────────────
# Robust Warehouse Inventory — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=4000
# Public origin of the app (used for password-reset links)
APP_BASE_URL=http://localhost:5173
# Comma-separated allowed origins for CORS in development
CLIENT_ORIGINS=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/robust_warehouse_inventory
# Separate database used by the automated test suite
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/robust_warehouse_inventory_test

# Business rules
TZ=Africa/Lagos
CURRENCY=NGN
# Staff must enter this 4-digit code on the dashboard to reveal total spend
DASHBOARD_UNLOCK_CODE=0017

# Session / security
SESSION_SECRET=replace-with-64-random-hex-characters
SESSION_TTL_HOURS=8
# Force Secure cookies (set true when served over HTTPS)
COOKIE_SECURE=false
# Set to the number of proxies in front of the app (0 locally)
TRUST_PROXY=0
# Disable only inside automated tests
RATE_LIMIT_DISABLED=false

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_FILES_PER_PURCHASE=5

# Email (Gmail SMTP example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Robust Warehouse Inventory <no-reply@example.com>"
# When SMTP is not configured, sign-in codes and reset links print to the server console in development
MAIL_DEV_CONSOLE_FALLBACK=true

# Password reset
RESET_TOKEN_TTL_MINUTES=30
